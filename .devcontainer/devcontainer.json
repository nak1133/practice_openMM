{
	"name": "practice_openMM DevContainer", // お好みの名前
	"service": "practice_openmm",
	"dockerComposeFile": "../environment/docker-compose.yml",
	"workspaceFolder": "/workspace/practice_openMM",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"charliermarsh.ruff",
				"ms-toolsai.jupyter",
				"njpwerner.autodocstring",
				"ms-azuretools.vscode-docker"
			],
			"settings": {
				"[python]": {
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.fixAll.ruff": "explicit",
						"source.organizeImports.ruff": "explicit"
					}
				},
				"ruff.format.args": [
					"--config=pyproject.toml"
				]
			}
		},
		"runArgs": ["--gpus", "all","--shm-size","2gb"]
	},
	"remoteUser": "user"
	// "postStartCommand": "pip install -e ."
}
